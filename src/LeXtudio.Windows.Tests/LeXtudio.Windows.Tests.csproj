<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <UnoSingleProject>true</UnoSingleProject>
    <WinUISDKReferences>false</WinUISDKReferences>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateTargetPlatformAttribute>false</GenerateTargetPlatformAttribute>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);WINDOWS_APP_SDK</DefineConstants>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BindingExpressionBridgeTests.cs" />
    <Compile Include="BindingEvaluatorTests.cs" />
    <Compile Include="CommandManagerBridgeTests.cs" />
    <Compile Include="BindingTests.cs" />
    <Compile Include="WpfSubstrateBridgeTests.cs" />
    <Compile Include="WpfTemplateFactoryTests.cs" />
    <Compile Include="WpfStyleFactoryTests.cs" />
    <Compile Include="WpfResourceFactoryTests.cs" />
    <Compile Include="WpfXamlResourceTranslatorTests.cs" />
    <Compile Include="DataGridBoundColumnTests.cs" />
    <Compile Include="DataGridExtensionsShimTests.cs" />
    <Compile Include="DataGridRomaMetadataSurfaceTests.cs" />
    <Compile Include="DataGridCellInfoTests.cs" />
    <Compile Include="DataGridCollectionTests.cs" />
    <Compile Include="DataGridControlRootPrereqTests.cs" />
    <Compile Include="DataGridControlRootLinkTests.cs" />
    <Compile Include="FocusAndAutomationBridgeTests.cs" />
    <Compile Include="DataGridColumnTests.cs" />
    <Compile Include="DataGridComboBoxColumnTests.cs" />
    <Compile Include="DataGridEventArgsTests.cs" />
    <Compile Include="DataGridLengthTests.cs" />
    <Compile Include="DataGridRowEventArgsTests.cs" />
    <Compile Include="DataGridSelectedCellsTests.cs" />
    <Compile Include="DataGridSpineLeafTests.cs" />
    <Compile Include="ItemCollectionViewTests.cs" />
    <Compile Include="SelectorSpineTests.cs" />
    <Compile Include="DataGridNotificationChainTests.cs" />
    <Compile Include="DataGridColumnHeaderNotificationTests.cs" />
    <Compile Include="VirtualizingRowsLayoutTests.cs" />
    <Compile Include="VirtualizingRowsRealizerTests.cs" />
    <Compile Include="VirtualizingRowsVariableLayoutTests.cs" />
    <Compile Include="RichTextBoxDocumentsTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <ProjectReference Include="..\LeXtudio.Windows\LeXtudio.Windows.csproj" SetTargetFramework="TargetFramework=net10.0-desktop" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="..\LeXtudio.Windows\LeXtudio.Windows.csproj" SetTargetFramework="TargetFramework=net10.0-windows10.0.19041.0" />
  </ItemGroup>

  <!-- Uno.Sdk may override OutputType to WinExe; restore to Exe before xUnit v3 validates -->
  <Target Name="EnsureExeOutputType" BeforeTargets="_XunitValidateBuild">
    <PropertyGroup>
      <OutputType>Exe</OutputType>
    </PropertyGroup>
  </Target>
</Project>
